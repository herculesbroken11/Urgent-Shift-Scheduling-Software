# BlueThread Solution — Local frontend environment
# Copy to .env and fill from Lovable Cloud → Project settings / API connection
#
# These VITE_* variables are PUBLIC in the production bundle. Use only the
# publishable (anon) key — never the service role key.

# === Demo mode (local sales demos only — keep false/disabled in production) ===
# When false, demo routes cannot bypass real Lovable Cloud / Supabase Auth.
VITE_ENABLE_DEMO_MODE=false

# Signup, email verification, and password rules are controlled in Lovable Cloud
# Auth settings (not env vars). For production pilot, consider disabling open signup
# in the dashboard and using invite-only onboarding.

# === Required ===
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# === Optional frontend ===
# Referenced in Platform Diagnostics; Google Calendar OAuth is primarily handled
# server-side via Edge Functions (GOOGLE_CALENDAR_* secrets in Lovable Cloud).
# VITE_GOOGLE_CALENDAR_CLIENT_ID="your-google-oauth-client-id"

# === Server-side secrets (Lovable Cloud → Secrets) ===
# Do NOT add these to .env. Configure in Lovable Cloud Secrets instead:
#
# Auto-provided to Edge Functions (platform-managed):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Integration secrets (you must configure):
#   RESEND_API_KEY
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
#   GOOGLE_CALENDAR_CLIENT_ID, GOOGLE_CALENDAR_CLIENT_SECRET
#   QBO_CLIENT_ID, QBO_CLIENT_SECRET, QBO_REDIRECT_URI, QBO_WEBHOOK_VERIFIER_TOKEN
#   QBO_ENVIRONMENT (sandbox | production)
#   APP_BASE_URL, SITE_URL
#   LOVABLE_API_KEY (auth email hook)
#   REMINDER_CRON_SECRET (process-reminders cron — set in Lovable Cloud; send as
#     x-reminder-cron-secret header or Authorization: Bearer <secret>)
