# Playwright E2E test credentials
# Copy to .env.test and fill in real values from your Lovable Cloud staging users.
# .env.test is gitignored — never commit real passwords.

# App URL under test
# Local dev:  http://localhost:8080
# Staging:    your Lovable published URL or custom domain
BASE_URL=http://localhost:8080

# Admin role
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# Scheduler role
SCHEDULER_EMAIL=scheduler@example.com
SCHEDULER_PASSWORD=your-scheduler-password

# Requester role
REQUESTER_EMAIL=requester@example.com
REQUESTER_PASSWORD=your-requester-password

# Interpreter role
INTERPRETER_EMAIL=interpreter@example.com
INTERPRETER_PASSWORD=your-interpreter-password
